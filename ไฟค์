    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 25)
    status.Position = UDim2.new(0, 0, 0, 185)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.new(1, 0.2, 0.2)
    status.TextSize = 14
    status.Font = Enum.Font.Gotham
    status.Parent = frame
    
    local function doLogin()
        local key = keyBox.Text
        if key == "Aongtong06" then
            status.Text = "✅ คีย์ถูกต้อง! เปิดระบบ..."
            status.TextColor3 = Color3.new(0, 1, 0)
            IS_LOGGED_IN = true
            task.wait(0.5)
            gui:Destroy()
            createMainUI()
            -- เปิดระบบอัตโนมัติ
            SYSTEM_ON = true
            XRAY_ON = true
            -- ตั้งค่าระบบกระโดด
            setupInfiniteJump()
            -- เริ่มลูปเอฟเฟกต์
            RunService.RenderStepped:Connect(function()
                applyXRayEffect()
            end)
        else
            status.Text = "❌ คีย์ผิด! ลองใหม่ไอ้โง่"
            status.TextColor3 = Color3.new(1, 0.2, 0.2)
            keyBox.Text = ""
        end
    end
    
    loginBtn.MouseButton1Click:Connect(doLogin)
    keyBox.FocusLost:Connect(function(enter)
        if enter then doLogin() end
    end)
    
    return gui
end

