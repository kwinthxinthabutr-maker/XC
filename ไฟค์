-- ============================================================
--  ระบบกระโดดไม่จำกัด (Infinite Jump)
-- ============================================================

local function setupInfiniteJump()
    -- ตรวจจับการกด Space
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not INFINITE_JUMP_ON then return end
        if not SYSTEM_ON then return end
        if input.KeyCode == Enum.KeyCode.Space then
            if humanoid and humanoid.Parent then
                -- กระโดดแบบไม่จำกัด (Override)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                -- เพิ่มแรงกระโดด
                humanoid.JumpPower = jumpPower
                -- หลอกระบบว่าไม่ได้อยู่บนพื้น (เพื่อกระโดดซ้ำ)
                task.wait(0.05)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            end
        end
    end)
    
    -- ตรวจจับการกดปุ่มเพิ่มพลังกระโดด
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Q then  -- กด Q เพิ่มแรงกระโดด
            jumpPower = math.min(100, jumpPower + 5)
            print("🔧 พลังกระโดด: " .. jumpPower)
        end
        if input.KeyCode == Enum.KeyCode.E then  -- กด E ลดแรงกระโดด
            jumpPower = math.max(20, jumpPower - 5)
            print("🔧 พลังกระโดด: " .. jumpPower)
        end
    end)
end

-- ฟังก์ชันเปิด/ปิดกระโดดไม่จำกัด
local function toggleInfiniteJump()
    INFINITE_JUMP_ON = not INFINITE_JUMP_ON
    if INFINITE_JUMP_ON then
        -- เปิดโหมดกระโดด
        humanoid.JumpPower = jumpPower
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        print("✅ กระโดดไม่จำกัด: ON")
    else
        -- ปิดโหมดกระโดด (คืนค่าเดิม)
        humanoid.JumpPower = 50
        print("❌ กระโดดไม่จำกัด: OFF")
    end
end

