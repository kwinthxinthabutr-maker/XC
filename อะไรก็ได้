            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            local role, weaponName = GetPlayerWeaponAndRole(player)
            
            -- ดึงหรือสร้างเฟรม
            local frame = espFrames[idx]
            if not frame then
                frame = Instance.new("Frame")
                frame.BackgroundTransparency = 0.3
                frame.BorderSizePixel = 3
                frame.BorderColor3 = Color3.new(1,1,1)
                frame.Size = UDim2.new(0, 180, 0, 80) -- ขยายใหญ่เพื่อให้เห็นชัด
                frame.Parent = espGui
                
                -- ชื่อผู้เล่น
