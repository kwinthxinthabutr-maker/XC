            else
                frame.Visible = false
            end
            idx = idx + 1
        end
    end
end

-- ==================== AutoAim นายอำเภอ (ยิงอัตโนมัติ) ====================
local function SheriffAim()
    if not AutoAimEnabled then return end
    local role, _ = GetPlayerWeaponAndRole(LocalPlayer)
    if role ~= "Sheriff" then return end
    local target = nil
    local minDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pRole, _ = GetPlayerWeaponAndRole(player)
            if pRole == "Murderer" then
                local dist = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist; target = player.Character.HumanoidRootPart
                end
            end
        end
    end
    if target then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0))
    end
end

-- ==================== AutoStab ฆาตกร (ไล่แทง) ====================
local function MurdererStab()
    if not AutoStabEnabled then return end
    local role, _ = GetPlayerWeaponAndRole(LocalPlayer)
    if role ~= "Murderer" then return end
    local target = nil
    local minDist = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pRole, _ = GetPlayerWeaponAndRole(player)
            if pRole == "Innocent" or pRole == "Sheriff" then
                local dist = (player.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist; target = player.Character.HumanoidRootPart
                end
            end
        end
    end
    if target then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:MoveTo(target.Position)
            if minDist < 6 then
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(0,0))
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(0,0))
            end
        end
    end
end

-- ==================== SpeedBoost ====================
local function SpeedBoost()
    if not SpeedBoostEnabled then return end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if humanoid then humanoid.WalkSpeed = SpeedValue end
end

-- ==================== NoClip ====================
local function NoClip()
    if not NoClipEnabled then return end
    if LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

-- ==================== Fly ====================
local function Fly()
    if not FlyEnabled then
        if flyBV then flyBV:Destroy(); flyBV = nil end
        flying = false
        return
    end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if not flying then
        flying = true
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(100000, 100000, 100000)
        flyBV.Velocity = Vector3.new(0, FlySpeed, 0)
        flyBV.Parent = char.HumanoidRootPart
    end
    if flyBV then
        local move = Vector3.new(0,0,0)
        local look = Camera.CFrame.LookVector
        local right = Camera.CFrame.RightVector
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + look * FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - look * FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right * FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right * FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, FlySpeed, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, FlySpeed, 0) end
        flyBV.Velocity = move
    end
end

-- ==================== Infinite Jump ====================
local jumpCount = 0
local function InfiniteJump()
    if not InfiniteJumpEnabled then return end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then
        jumpCount = jumpCount + 1
    else
        jumpCount = 0
    end
    if jumpCount <= 5 and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        humanoid.Jump = true
        jumpCount = jumpCount + 1
    end
end

-- ==================== AntiAFK ====================
local function AntiAFK()
    if not AntiAFKEnabled then return end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if humanoid and humanoid.RootPart then
        humanoid:MoveTo(humanoid.RootPart.Position + Vector3.new(math.random(-2,2), 0, math.random(-2,2)))
    end
end

