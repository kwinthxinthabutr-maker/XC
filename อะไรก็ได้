-- ==================== สร้าง GUI หลัก ====================
local function SetupESP()
    if espGui then espGui:Destroy() end
    espGui = Instance.new("ScreenGui")
    espGui.Name = "SaikutoESP"
    espGui.Parent = LocalPlayer.PlayerGui
    espFrames = {}
end

-- ==================== ตรวจจับบทบาท + อาวุธที่ถือ ====================
local function GetPlayerWeaponAndRole(player)
    if not player or not player.Character then 
        return "Innocent", "ไม่มีอาวุธ" 
    end
    for _, tool in ipairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("dagger") or name:find("blade") then
                return "Murderer", tool.Name
            elseif name:find("gun") or name:find("pistol") or name:find("revolver") or name:find("sheriff") then
                return "Sheriff", tool.Name
            end
        end
    end
    return "Innocent", "ไม่มีอาวุธ"
end

-- ==================== ESP แสดงอาวุธแบบเด่นชัด (ไม่กระพริบ) ====================
local function UpdateESP()
    if not ESPEnabled then
        if espGui then espGui.Enabled = false end
        return
    end
    if not espGui then SetupESP() end
    espGui.Enabled = true

    -- นับจำนวนผู้เล่นเพื่อจัดการเฟรม
    local count = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            count = count + 1
        end
    end
    while #espFrames > count do
        local f = table.remove(espFrames)
        if f then f:Destroy() end
    end

    local idx = 1
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
