                nameLabel.Size = UDim2.new(1,0, 0.35,0)
                nameLabel.Position = UDim2.new(0,0, 0,0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.TextScaled = true
                nameLabel.Font = Enum.Font.SourceSansBold
                nameLabel.TextColor3 = Color3.new(1,1,1)
                nameLabel.Parent = frame
                
                -- ไอคอนอาวุธ (ใหญ่เด่น)
                local weaponIcon = Instance.new("TextLabel")
                weaponIcon.Name = "WeaponIcon"
                weaponIcon.Size = UDim2.new(0, 50, 0, 50)
                weaponIcon.Position = UDim2.new(0.5, -25, 0.35, 0)
                weaponIcon.BackgroundTransparency = 1
                weaponIcon.TextScaled = true
                weaponIcon.Font = Enum.Font.SourceSansBold
                weaponIcon.Parent = frame
                
                -- ชื่ออาวุธ
                local weaponNameLabel = Instance.new("TextLabel")
                weaponNameLabel.Name = "WeaponName"
                weaponNameLabel.Size = UDim2.new(1,0, 0.3,0)
                weaponNameLabel.Position = UDim2.new(0,0, 0.7,0)
                weaponNameLabel.BackgroundTransparency = 1
                weaponNameLabel.TextScaled = true
                weaponNameLabel.Font = Enum.Font.SourceSansBold
                weaponNameLabel.TextColor3 = Color3.new(1,1,0)
                weaponNameLabel.Parent = frame
                
                -- แถบ HP
                local hp = Instance.new("Frame")
                hp.Name = "HPBar"
                hp.Size = UDim2.new(1,0, 0.08,0)
                hp.Position = UDim2.new(0,0, 0.92,0)
                hp.BackgroundTransparency = 0.3
                hp.BorderSizePixel = 0
                hp.BackgroundColor3 = Color3.new(0,1,0)
                hp.Parent = frame
                
                espFrames[idx] = frame
            end
            
            if onScreen then
                frame.Visible = true
                frame.Position = UDim2.new(0, screenPos.X - 90, 0, screenPos.Y - 100)
                
                -- อัปเดตตามบทบาท
                if role == "Innocent" then
                    frame.BackgroundColor3 = Color3.new(0, 0.6, 0)
                    frame.NameLabel.Text = player.Name .. " 👤"
                    frame.WeaponIcon.Text = "❌"
                    frame.WeaponName.Text = "ไม่มีอาวุธ"
                elseif role == "Sheriff" then
