-- 🦠 ฟังก์ชัน ESP
local function createESP()
	local espFolder = Instance.new("Folder")
	espFolder.Name = "ESP_Folder_👾"
	espFolder.Parent = game.CoreGui

	local function addESP(player)
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChild("Humanoid")
		local head = character:FindFirstChild("Head")
		local root = character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not head or not root then return end

		-- Highlight กล่องแดง
		local highlight = Instance.new("Highlight")
		highlight.Name = player.Name
		highlight.FillColor = Color3.fromRGB(255, 0, 0)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.Parent = espFolder

		-- 🥷 เส้นลากไปหาเป้า (Tracer)
		local tracer = Drawing.new("Line")
		tracer.Color = Color3.fromRGB(255, 50, 50)
		tracer.Thickness = 1
		tracer.Transparency = 0.6
		tracer.Visible = true

		-- 👽 BillboardGui แสดงข้อมูล
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Info_" .. player.Name
		billboard.Size = UDim2.new(0, 200, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local infoLabel = Instance.new("TextLabel")
		infoLabel.Size = UDim2.new(1, 0, 1, 0)
		infoLabel.BackgroundTransparency = 1
		infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		infoLabel.Font = Enum.Font.SourceSansBold
		infoLabel.TextSize = 13
		infoLabel.TextStrokeTransparency = 0
		infoLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		infoLabel.Parent = billboard

		-- ❄️ อัปเดตข้อมูล + Tracer
		local connection
		connection = RunService.RenderStepped:Connect(function()
			if not character or not character.Parent or not humanoid or humanoid.Health <= 0 then
				connection:Disconnect()
				highlight:Destroy()
				billboard:Destroy()
				tracer:Remove()
				return
			end

			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local pos = root.Position
			local dist = myRoot and math.floor((myRoot.Position - pos).Magnitude) or 0
			infoLabel.Text = string.format("%s\n❤️ HP: %.0f | 📏 %dm", player.Name, humanoid.Health, dist)

			-- อัปเดตเส้น Tracer
			local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
			local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
			if onScreen then
				tracer.From = screenCenter
				tracer.To = Vector2.new(screenPos.X, screenPos.Y)
			else
				tracer.From = screenCenter
				tracer.To = screenCenter
			end
		end)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			addESP(player)
		end
	end

	Players.PlayerAdded:Connect(function(player)
		if player ~= LocalPlayer then
			player.CharacterAdded:Connect(function()
				task.wait(0.5)
				addESP(player)
			end)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local espFolder = game.CoreGui:FindFirstChild("ESP_Folder_👾")
		if espFolder then
			local hl = espFolder:FindFirstChild(player.Name)
			if hl then hl:Destroy() end
		end
	end)

	return espFolder
end

local currentESP = nil

local function clearESP()
	if currentESP then
		currentESP:Destroy()
		currentESP = nil
	end
end

-- 🔨 ฟังก์ชัน Aimbot หาเป้า
local function getClosestInFOV()
	local closest = nil
	local shortestDistance = fovRadius
	local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char then continue end
		local head = char:FindFirstChild("Head")
		local humanoid = char:FindFirstChild("Humanoid")
		if not head or not humanoid or humanoid.Health <= 0 then continue end

		local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
		if dist < shortestDistance then
			shortestDistance = dist
			closest = player
		end
	end
	return closest
end

