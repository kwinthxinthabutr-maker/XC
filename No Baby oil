local function askBoxAI(question, updateCallback)
   local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
   if not httpRequest then
      updateCallback("❌ ตัวรัน Delta ไม่รองรับคำสั่ง http_request")
      return
   end

   table.insert(conversationHistory, { role = "user", content = question })

   local cleanKey = currentApiKey:gsub("%s+", "")
   local bodyData = {
      model = "deepseek-chat",
      messages = conversationHistory
   }

   local headers = {
      ["Content-Type"] = "application/json",
      ["Authorization"] = "Bearer " .. cleanKey
   }

   local success, response = pcall(function()
      return httpRequest({
         Url = "https://api.deepseek.com/chat/completions",
         Method = "POST",
         Headers = headers,
         Body = HttpService:JSONEncode(bodyData)
      })
   end)

   if success and response then
      local decodeSuccess, decoded = pcall(function()
         return HttpService:JSONDecode(response.Body)
      end)

      if decodeSuccess and decoded then
         if decoded.choices and decoded.choices[1] and decoded.choices[1].message then
            local aiReply = decoded.choices[1].message.content
            table.insert(conversationHistory, { role = "assistant", content = aiReply })
            
            local codeMatch = aiReply:match("```lua\n(.-)```") or aiReply:match("```(.-)```")
            if codeMatch then
               lastExtractedCode = codeMatch
            end

            chatLogDisplay = chatLogDisplay .. "\n\n👤 คุณ: " .. question .. "\n🤖 Box AI:\n" .. aiReply
            updateCallback(chatLogDisplay)
            return
         elseif decoded.error then
            table.remove(conversationHistory, #conversationHistory)
            updateCallback(chatLogDisplay .. "\n\n⚠️ ข้อผิดพลาด API: " .. tostring(decoded.error.message))
            return
         end
      end
      table.remove(conversationHistory, #conversationHistory)
      updateCallback(chatLogDisplay .. "\n\n⚠️ Error: " .. tostring(response.Body))
   else
      table.remove(conversationHistory, #conversationHistory)
      updateCallback(chatLogDisplay .. "\n\n❌ การเชื่อมต่อล้มเหลว")
   end
end

