local function getHomePosition()
   local spawnLocation = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawns")
   if spawnLocation then
      if spawnLocation:IsA("BasePart") then
         return spawnLocation.Position + Vector3.new(0, 5, 0)
      else
         local firstSpawn = spawnLocation:FindFirstChildWhichIsA("BasePart")
         if firstSpawn then
            return firstSpawn.Position + Vector3.new(0, 5, 0)
         end
      end
   end
   return Vector3.new(0, 15, 0)
end

local function flyBackHomeSync()
   local char = player.Character
   if not char or not char:FindFirstChild("HumanoidRootPart") then return end
   local hrp = char.HumanoidRootPart
   local targetPos = getHomePosition()

   local bv = Instance.new("BodyVelocity")
   bv.Velocity = Vector3.zero
   bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
   bv.Parent = hrp

   local noclipConn = RunService.Stepped:Connect(function()
      pcall(function()
         for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
               p.CanCollide = false
            end
         end
      end)
   end)

   while true do
      if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then break end
      local currentPos = hrp.Position
      local direction = (targetPos - currentPos)
      local distance = direction.Magnitude

      if distance < 10 then break end
      bv.Velocity = direction.Unit * flySpeed
      task.wait()
   end

   if bv then bv:Destroy() end
   if noclipConn then noclipConn:Disconnect() end
   if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end

   pcall(function()
      for _, p in pairs(char:GetDescendants()) do
         if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
         end
      end
   end)
end

local function findEggTarget(keyword)
   local targetKeyword = keyword:lower()
   for _, label in pairs(workspace:GetDescendants()) do
      if label:IsA("TextLabel") and label.Text:lower():find(targetKeyword) then
         local part = label:FindFirstAncestorWhichIsA("BasePart") or label:FindFirstAncestorWhichIsA("Model")
         if part then
            local targetPart = part:IsA("BasePart") and part or (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart"))
            if targetPart then return targetPart end
         end
      end
   end
   for _, obj in pairs(workspace:GetDescendants()) do
      if obj.Name:lower():find(targetKeyword) then
         local targetPart = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
         if targetPart then return targetPart end
      end
   end
   return nil
end

local function triggerNearbyPrompts()
   pcall(function()
      local char = player.Character
      if not char or not char:FindFirstChild("HumanoidRootPart") then return end
      local pos = char.HumanoidRootPart.Position

      for _, prompt in pairs(workspace:GetDescendants()) do
         if prompt:IsA("ProximityPrompt") then
            local promptPart = prompt:FindFirstAncestorWhichIsA("BasePart")
            if promptPart and (promptPart.Position - pos).Magnitude <= (prompt.MaxActivationDistance + 10) then
               fireproximityprompt(prompt, 1)
            end
         end
      end
   end)
end

